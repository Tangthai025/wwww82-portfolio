# Database connection (SQLite default for local, or postgresql://... for PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Authentication secret for JWT session encryption
AUTH_SECRET="change-to-a-random-32-character-secret-in-production"

# Next.js Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL=""
